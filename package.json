{
  "name": "sentinel-project-manager",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "dev:web": "npm run dev --workspace @spm/web",
    "build:web": "npm run build --workspace @spm/web",
    "type-check:web": "npm run type-check --workspace @spm/web",
    "dev:api": "npm run dev --workspace @spm/api",
    "build:api": "npm run build --workspace @spm/api",
    "type-check:api": "npm run type-check --workspace @spm/api",
    "verify:web": "npm run type-check:web && npm run build:web",
    "db:generate": "cd apps/api && npx prisma generate",
    "db:migrate": "cd apps/api && npx prisma migrate dev",
    "db:studio": "cd apps/api && npx prisma studio"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@dnd-kit/modifiers": "^9.0.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
