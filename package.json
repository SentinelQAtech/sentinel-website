{
  "name": "sentinel-core",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "dev:core": "npm run dev --workspace @sentinel-core/core",
    "build:core": "npm run build --workspace @sentinel-core/core",
    "type-check:core": "npm run type-check --workspace @sentinel-core/core",
    "dev:web": "npm run dev:core",
    "build:web": "npm run build:core",
    "type-check:web": "npm run type-check:core",
    "dev:api": "npm run dev --workspace @sentinel-core/api",
    "build:api": "npm run build --workspace @sentinel-core/api",
    "type-check:api": "npm run type-check --workspace @sentinel-core/api",
    "verify:core": "npm run type-check:core && npm run build:core",
    "verify:web": "npm run verify:core",
    "test:e2e:core": "npm run test:e2e --workspace @sentinel-core/core --",
    "db:generate": "cd apps/api && npx prisma generate",
    "db:migrate": "cd apps/api && npx prisma migrate dev",
    "db:seed": "cd apps/api && npx prisma db seed",
    "db:studio": "cd apps/api && npx prisma studio"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.3.3",
    "tsx": "^4.22.4",
    "turbo": "^2.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@dnd-kit/modifiers": "^9.0.0",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
