# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/sentinel-core"

# ─── JWT — Local auth tokens ───────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-random-64-char-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-to-another-random-64-char-string"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Supabase — Auth bridge (session → JWT exchange) ──────────────────────────
# Found in Supabase Dashboard → Project Settings → API
SUPABASE_URL="https://your-project.supabase.co"
# Service role key (NOT the anon key). Keep secret — full access to your Supabase project.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─── Server ────────────────────────────────────────────────────────────────────
PORT="3001"
CORS_ORIGINS="http://localhost:3000,https://sentinelqa.tech"
