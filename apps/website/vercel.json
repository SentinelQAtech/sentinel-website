{
  "installCommand": "node -e \"console.log('No install required for static website')\"",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/core",
      "destination": "/core/dashboard",
      "permanent": false
    },
    {
      "source": "/core/",
      "destination": "/core/dashboard",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "app.sentinelqa.tech" }
      ],
      "destination": "https://sentinelqa.tech/core/dashboard",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "app.sentinelqa.tech" }
      ],
      "destination": "https://sentinelqa.tech/core/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/core",
      "destination": "https://sentinel-core-iota.vercel.app/core"
    },
    {
      "source": "/core/:path*",
      "destination": "https://sentinel-core-iota.vercel.app/core/:path*"
    }
  ]
}
